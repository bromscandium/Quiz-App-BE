HOST=0.0.0.0
PORT=8000
MODE=dev
ALLOWED_ORIGINS=["localhost:3000","0.0.0.0:3000"]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quiz_db
POSTGRES_URL=postgresql+asyncpg://postgres:password@postgres:5432/quiz_db
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_RECYCLE=3600
POSTGRES_DEBUG=False

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

JWT_SECRET_KEY=original_secret_key_in_dotenv
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_RAW_TOKEN_BYTES=64
JWT_PRIVATE_KEY_PATH=./secrets/private.pem
JWT_PUBLIC_KEY_PATH=./secrets/public.pem

AUTH0_DOMAIN=dev-f6q67uvkq5szgxwa.us.auth0.com
AUTH0_API_AUDIENCE=https://api.quizapp.com