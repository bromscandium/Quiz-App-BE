HOST=127.0.0.1
PORT=8080
MODE=development
ALLOWED_ORIGINS=["localhost:4000","127.0.0.1:4000"]

POSTGRES_USER=fake_user
POSTGRES_PASSWORD=fake_password_!23
POSTGRES_HOST=db-fake
POSTGRES_PORT=5434
POSTGRES_DB=fake_quiz_db
POSTGRES_URL=postgresql+asyncpg://fake_user:fake_password_!23@db-fake:5434/fake_quiz_db
POSTGRES_POOL_SIZE=3
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_RECYCLE=1800
POSTGRES_DEBUG=False

TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=password
TEST_POSTGRES_HOST=test-postgres
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=quiz_test_db
TEST_POSTGRES_URL=postgresql+asyncpg://postgres:password@test-postgres:5433/quiz_test_db

REDIS_HOST=redis-fake
REDIS_PORT=6390
REDIS_URL=redis://redis-fake:6390

TEST_REDIS_HOST=test-redis
TEST_REDIS_PORT=6380
TEST_REDIS_URL=redis://test-redis:6380

JWT_SECRET_KEY=change_me_fake_secret_0000000000000000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RAW_TOKEN_BYTES=32
JWT_PRIVATE_KEY_PATH=./secrets/fake_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/fake_public.pem

AUTH0_DOMAIN=dev-example.auth0.fake
AUTH0_API_AUDIENCE=https://api.fake-quiz.local